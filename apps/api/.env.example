# Server
NODE_ENV=development
PORT=3000
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/testimona

# Redis
REDISCLOUD_URL=redis://localhost:6379

# CORS
WHITELIST_URL=http://localhost:4200|http://localhost:8080
WEBSITE_URL=http://localhost:4200

# JWT / Auth
TOKEN_KEY=your_jwt_secret_key_here
TOKEN_SUFFIX=_dev
TOKEN_EXPIRED_SECONDS=3600
TOKEN_EXPIRED_SECONDS_REFRESH=86400
SECURE_COOKIE=false

# Encryption
PRIVATE_PWD_KEY=your_private_pwd_key_here
SECRET_PWD_KEY=your_secret_pwd_key_here
SECRET_ANSWER_KEY=your_secret_answer_key_here

# Expiration (seconds)
CONFIG_EXPIRED=86400
MEMORIAL_EXPIRED=3600
USER_EXPIRED=3600

# Cloudinary
CLOUDINARY_BACKUP_DIRECTORY=deleted

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email
CONTACT_EMAIL=contact@testimona.com

# Logging
LOG_LEVEL=info
DEBUG_ON=true

# Supabase (Phase 3 of migration plan)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Observability (Phase 7 of migration plan)
SENTRY_DSN=
GIT_SHA=

# Stripe webhook signing (existing endpoint)
STRIPE_WEBHOOK_SECRET=whsec_
