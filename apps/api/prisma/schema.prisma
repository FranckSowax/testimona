// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// region Types tables
enum AuthenticationMode {
  Facebook
  Google
  Site
}

enum DisplayName {
  NicknameFirstnameLastname
  Nickname
  FirstnameLastname
}

enum DonationStatus {
  Canceled
  Processing
  Requires_action
  Requires_capture
  Requires_confirmation
  Requires_payment_method
  Succeeded
}

enum Gender {
  Male
  Female
  Other
  NotSpecified
}

enum HourPeriod {
  Null
  AM
  PM
}

enum LogTypeError {
  Debug
  Error
  Info
  Log
  Warn
}

enum MediaObjectType {
  Chapter
  MemorialBackground
  MemorialProfile
  Photo
  Testimonial
  UserProfile
}

enum MemorialRequestAdminStatus {
  Pending
  Accepted
  Rejected
}

enum NotificationType {
  Page
  Testimonial
}

enum Relative {
  Parent
  Spouse
  Partner
  Child
  Family
  Friend
  Colleague
  Other
  DoNotWishToDisclose
  Undefined
}

enum SendNotificationType {
  Email
  Notification
  EmailAndNotification
  NotSpecified
}

enum UserRole {
  Admin
  Relatives
  User
}

// endregion

// region System tables
model Country {
  countryId Int      @id
  code      String   @db.VarChar(5)
  name      String   @db.VarChar(100)
  flag      String   @db.VarChar(50)
  createAt  DateTime @default(now()) @db.Timestamptz(6)
  disabled  Boolean  @default(false)

  countryOfBirthMemorials Memorial[] @relation("memorial_country_birth")
  countryOfDeathMemorials Memorial[] @relation("memorial_country_death")

  @@map(name: "countries")
}

model Language {
  languageId Int      @id
  code       String   @unique @db.VarChar(5)
  label      String   @db.VarChar(50)
  createAt   DateTime @default(now()) @db.Timestamptz(6)
  disabled   Boolean  @default(true)

  users User[] @relation("user_language")

  @@map(name: "languages")
}

model Log {
  LogId    Int          @id @default(autoincrement())
  Type     LogTypeError
  Info     Json         @db.Json
  Error    Json         @db.Json
  createAt DateTime     @default(now()) @db.Timestamptz(6)

  @@map(name: "logs")
}

model MailLogs {
  mailLogId    String   @id @db.Uuid
  memorialId   String?  @db.VarChar(100)
  mailDetails  Json     @db.Json
  mailId       String?  @db.VarChar(200)
  mailResponse String?  @db.VarChar(100)
  success      Boolean  @db.Boolean
  error        Json     @db.Json
  createAt     DateTime @default(now()) @db.Timestamptz(6)

  @@map(name: "mailLogs")
}

model SecurityQuestion {
  securityQuestionsId Int      @id
  contentKey          String   @db.VarChar(300)
  createByIdFk        String
  createAt            DateTime @default(now()) @db.Timestamptz(6)

  userCreate User @relation("security_questions_user_create", fields: [createByIdFk], references: [userId])

  securityQuestionUsers SecurityQuestionUserAnswer[] @relation("securityQuestionUserAnswer_securityQuestion")

  @@map(name: "security_questions")
}

// endregion System tables

// region Application tables
model Biography {
  biographyId  Int      @default(autoincrement())
  memorialIdFk Int      @id
  nicknames    String   @db.VarChar(5000)
  homeCity     String   @db.VarChar(5000)
  placesLived  String   @db.VarChar(5000)
  religion     String   @db.VarChar(5000)
  education    String   @db.VarChar(5000)
  work         String   @db.VarChar(5000)
  hobbies      String   @db.VarChar(5000)
  createByIdFk String
  createAt     DateTime @default(now()) @db.Timestamptz(6)
  updateByIdFk String
  updateAt     DateTime @default(now()) @db.Timestamptz(6)
  disabled     Boolean  @default(false)

  memorial   Memorial @relation("biography_memorial", fields: [memorialIdFk], references: [memorialId])
  userCreate User     @relation("biography_user_create", fields: [createByIdFk], references: [userId])
  userUpdate User     @relation("biography_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "biographies")
}

model Chapter {
  chapterId    Int      @id @default(autoincrement())
  memorialIdFk Int
  title        String   @db.VarChar(500)
  content      String   @db.VarChar(5000)
  createByIdFk String
  createAt     DateTime @default(now()) @db.Timestamptz(6)
  updateByIdFk String
  updateAt     DateTime @default(now()) @db.Timestamptz(6)
  disabled     Boolean  @default(false)

  memorial   Memorial @relation("chapter_memorial", fields: [memorialIdFk], references: [memorialId])
  userCreate User     @relation("chapter_user_create", fields: [createByIdFk], references: [userId])
  userUpdate User     @relation("chapter_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "chapters")
}

model Donation {
  donationId   String         @id
  memorialIdFk Int
  userIdFk     String
  checkoutId   String         @default("")
  donorEmail   String         @default("")
  comment      String         @default("") @db.VarChar(5000)
  amount       Int            @default(0)
  anonymous    Boolean        @default(false)
  date         DateTime       @default(now()) @db.Timestamptz(6)
  status       DonationStatus

  memorial Memorial @relation("donation_memorial", fields: [memorialIdFk], references: [memorialId])
  donor    User     @relation("donation_user_donor", fields: [userIdFk], references: [userId])

  @@map(name: "donations")
}

model Funeral {
  funeralId    Int      @default(autoincrement())
  memorialIdFk Int      @id
  content      String   @db.VarChar(5000)
  createByIdFk String
  createAt     DateTime @default(now()) @db.Timestamptz(6)
  updateByIdFk String
  updateAt     DateTime @default(now()) @db.Timestamptz(6)
  disabled     Boolean  @default(false)

  memorial   Memorial @relation("funeral_memorial", fields: [memorialIdFk], references: [memorialId])
  userCreate User     @relation("funeral_user_create", fields: [createByIdFk], references: [userId])
  userUpdate User     @relation("funeral_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "funerals")
}

model FuneralEvent {
  funeralEventId  Int        @id @default(autoincrement())
  memorialIdFk    Int
  title           String     @db.VarChar(500)
  date            String     @db.VarChar(10)
  startHour       String     @db.VarChar(5)
  startHourPeriod HourPeriod
  endHour         String?    @db.VarChar(5)
  endHourPeriod   HourPeriod
  url             String?    @db.VarChar(500)
  note            String?    @db.VarChar(5000)
  location        String?    @db.VarChar(5000)
  createByIdFk    String
  createAt        DateTime   @default(now()) @db.Timestamptz(6)
  updateByIdFk    String
  updateAt        DateTime   @default(now()) @db.Timestamptz(6)
  disabled        Boolean    @default(false)

  memorial   Memorial @relation("funeral_event_memorial", fields: [memorialIdFk], references: [memorialId])
  userCreate User     @relation("funeral_event_user_create", fields: [createByIdFk], references: [userId])
  userUpdate User     @relation("funeral_event_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "funeralEvents")
}

model Memorial {
  memorialId         Int               @id @default(autoincrement())
  url                String            @unique @db.VarChar(300)
  firstname          String            @db.VarChar(100)
  lastname           String            @db.VarChar(100)
  yearOfBirth        Int               @default(0)
  monthOfBirth       Int               @default(0)
  dayOfBirth         Int               @default(0)
  countryOfBirthIdFk Int?
  cityOfBirth        String?           @db.VarChar(100)
  yearOfDeath        Int               @default(0)
  monthOfDeath       Int               @default(0)
  dayOfDeath         Int               @default(0)
  countryOfDeathIdFk Int
  cityOfDeath        String?           @db.VarChar(100)
  shortBiography     String?           @db.VarChar(500)
  donationGoal       MemorialDonation?
  createByIdFk       String
  createAt           DateTime          @default(now()) @db.Timestamptz(6)
  updateByIdFk       String
  updateAt           DateTime          @default(now()) @db.Timestamptz(6)
  disabled           Boolean           @default(false)

  countryOfBirth Country? @relation("memorial_country_birth", fields: [countryOfBirthIdFk], references: [countryId])
  countryOfDeath Country  @relation("memorial_country_death", fields: [countryOfDeathIdFk], references: [countryId])
  userCreate     User     @relation("memorial_user_create", fields: [createByIdFk], references: [userId])
  userUpdate     User     @relation("memorial_user_update", fields: [updateByIdFk], references: [userId])

  biographies              Biography[]                @relation("biography_memorial")
  chapters                 Chapter[]                  @relation("chapter_memorial")
  donations                Donation[]                 @relation("donation_memorial")
  // donationsGoal            MemorialDonation[]         @relation("memorialDonation_memorial")
  funerals                 Funeral[]                  @relation("funeral_memorial")
  funeralEvents            FuneralEvent[]             @relation("funeral_event_memorial")
  memorialRequestAdmin     MemorialRequestAdmin[]     @relation("memorialRequestAdmin_memorial")
  memorialUserRelationship MemorialUserRelationship[] @relation("memorialUserRelationship_memorial")
  testimonials             Testimonial[]              @relation("testimonial_memorial")

  @@map(name: "memorials")
}

model Photo {
  photoId      String          @id
  objectId     String
  objectType   MediaObjectType
  publicId     String          @unique
  path         String
  version      Int
  format       String
  size         Int
  type         String
  url          String
  accessMode   String
  numberOfLike Int             @default(0)
  isDeleted    Boolean         @default(false)
  createByIdFk String
  createAt     DateTime        @default(now()) @db.Timestamptz(6)
  updateByIdFk String
  updateAt     DateTime        @default(now()) @db.Timestamptz(6)

  userCreate User @relation("photo_user_create", fields: [createByIdFk], references: [userId])
  userUpdate User @relation("photo_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "photos")
}

model Testimonial {
  testimonialId Int      @id @default(autoincrement())
  memorialIdFk  Int
  content       String   @db.VarChar(5000)
  numberOfLike  Int      @default(0)
  createByIdFk  String
  createAt      DateTime @default(now()) @db.Timestamptz(6)
  updateByIdFk  String
  updateAt      DateTime @default(now()) @db.Timestamptz(6)
  disabled      Boolean  @default(false)

  memorial   Memorial @relation("testimonial_memorial", fields: [memorialIdFk], references: [memorialId])
  userCreate User     @relation("testimonial_user_create", fields: [createByIdFk], references: [userId])
  userUpdate User     @relation("testimonial_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "testimonials")
}

model User {
  userId               String               @id
  socialUserId         String?              @unique @db.VarChar(50)
  nickname             String               @db.VarChar(50)
  firstname            String?              @db.VarChar(50)
  lastname             String?              @db.VarChar(50)
  maidenname           String?              @db.VarChar(50)
  displayName          DisplayName
  address              String?              @db.VarChar(100)
  apartment            String?              @db.VarChar(10)
  city                 String?              @db.VarChar(50)
  postalCode           String?              @db.VarChar(50)
  province             String?              @db.VarChar(50)
  country              String?              @db.VarChar(5)
  birthdate            DateTime?            @db.Date
  placeOfBirth         String?              @db.VarChar(50)
  phone                String?              @db.VarChar(20)
  email                String               @unique @db.VarChar(100)
  password             String?              @db.VarChar(100)
  passwordTmp          String?              @db.VarChar(50)
  sex                  Gender?
  languageIdFk         Int
  role                 UserRole             @default(User)
  sendNotificationType SendNotificationType @default(EmailAndNotification)
  loginType            AuthenticationMode
  dataLoginFromOther   Json?                @db.Json
  createAt             DateTime             @default(now()) @db.Timestamptz(6)
  lastLoginAt          DateTime             @default(now()) @db.Timestamptz(6)
  lastUpdatedAt        DateTime             @default(now()) @db.Timestamptz(6)
  activated            Boolean              @default(false)
  disabled             Boolean              @default(false)

  language Language @relation("user_language", fields: [languageIdFk], references: [languageId])

  createBiographies       Biography[]        @relation("biography_user_create")
  updateBiographies       Biography[]        @relation("biography_user_update")
  createChapters          Chapter[]          @relation("chapter_user_create")
  updateChapters          Chapter[]          @relation("chapter_user_update")
  donorDonations          Donation[]         @relation("donation_user_donor")
  createFunerals          Funeral[]          @relation("funeral_user_create")
  updateFunerals          Funeral[]          @relation("funeral_user_update")
  createFuneralEvents     FuneralEvent[]     @relation("funeral_event_user_create")
  updateFuneralEvents     FuneralEvent[]     @relation("funeral_event_user_update")
  userIdWhoLiked          likeItem[]         @relation("likeitem_user_create")
  createMemorials         Memorial[]         @relation("memorial_user_create")
  updateMemorials         Memorial[]         @relation("memorial_user_update")
  createPhotos            Photo[]            @relation("photo_user_create")
  updatePhotos            Photo[]            @relation("photo_user_update")
  createSecurityQuestions SecurityQuestion[] @relation("security_questions_user_create")
  createTestimonials      Testimonial[]      @relation("testimonial_user_create")
  updateTestimonials      Testimonial[]      @relation("testimonial_user_update")

  applicantMemorialRequestAdmin MemorialRequestAdmin[]       @relation("memorialRequestAdmin_user_applicant")
  updateMemorialRequestAdmin    MemorialRequestAdmin[]       @relation("memorialRequestAdmin_user_update")
  memorialUserRelationship      MemorialUserRelationship[]   @relation("memorialUserRelationship_user")
  securityQuestionUsers         SecurityQuestionUserAnswer[] @relation("securityQuestionUserAnswer_user")

  @@map(name: "users")
}

//endregion Application tables

// region Link tables
model likeItem {
  userId     String
  itemId     String
  objectType MediaObjectType
  createAt   DateTime        @default(now()) @db.Timestamptz(6)

  userIdWhoLiked User @relation("likeitem_user_create", fields: [userId], references: [userId])

  @@id([userId, itemId, objectType])
  @@map(name: "likeItems")
}

model MemorialDonation {
  memorialIdFk   Int    @unique
  DonationGoal   Int    @default(0)
  AmountDonation Int    @default(0)
  Message        String @db.VarChar(3000) @default("")

  memorial Memorial @relation(fields: [memorialIdFk], references: [memorialId])

  @@map(name: "memorialDonation")
}

model MemorialRequestAdmin {
  memorialRequestAdminId String                     @id
  memorialIdFk           Int
  applicantUserIdFk      String
  relationship           Relative
  note                   String                     @db.VarChar(500)
  status                 MemorialRequestAdminStatus
  createAt               DateTime                   @default(now()) @db.Timestamptz(6)
  updateByIdFk           String
  updateAt               DateTime                   @default(now()) @db.Timestamptz(6)

  memorial      Memorial @relation("memorialRequestAdmin_memorial", fields: [memorialIdFk], references: [memorialId])
  applicantUser User     @relation("memorialRequestAdmin_user_applicant", fields: [applicantUserIdFk], references: [userId])
  userUpdate    User     @relation("memorialRequestAdmin_user_update", fields: [updateByIdFk], references: [userId])

  @@map(name: "memorialRequestAdmin")
}

model MemorialUserRelationship {
  memorialIdFk Int
  userIdFk     String
  relationship Relative
  isAdmin      Boolean  @default(false)
  createAt     DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial @relation("memorialUserRelationship_memorial", fields: [memorialIdFk], references: [memorialId])
  user     User     @relation("memorialUserRelationship_user", fields: [userIdFk], references: [userId])

  @@id([memorialIdFk, userIdFk])
  @@map(name: "memorialUserRelationship")
}

model SecurityQuestionUserAnswer {
  securityQuestionsIdFk Int
  userIdFk              String
  answer                String   @db.VarChar(50)
  createAt              DateTime @default(now()) @db.Timestamptz(6)

  securityQuestions SecurityQuestion @relation("securityQuestionUserAnswer_securityQuestion", fields: [securityQuestionsIdFk], references: [securityQuestionsId])
  user              User             @relation("securityQuestionUserAnswer_user", fields: [userIdFk], references: [userId])

  @@id([securityQuestionsIdFk, userIdFk])
  @@map(name: "securityQuestionUserAnswer")
}

// endregion Link tables
