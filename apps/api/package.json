{
  "name": "api.testimona.com",
  "version": "1.0.0",
  "description": "Api endpoints to manage data for Testimona project",
  "main": "/dist/app.js",
  "scripts": {
    "copyfilesdev": "nodemon --watch src/assets -e json,yaml --delay 1 --exec copyfiles -u 1 src/assets/** dist",
    "swaggerdev": "nodemon --watch dist -e json --delay 2 node ./dist/app.js",
    "builddev": "nodemon -e ts,json --delay 1 --exec tsc",
    "startdev": "nodemon -e js --delay 2 node ./dist/app.js",
    "postbuild": "tsc && node move-files.js",
    "start": "node ./dist/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testimona/api.git"
  },
  "author": "MF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/testimona/api/issues"
  },
  "homepage": "https://github.com/testimona/api#readme",
  "dependencies": {
    "@joi/date": "^2.1.0",
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@testimona/shared": "workspace:*",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fs-extra": "^11.2.0",
    "google-auth-library": "^9.14.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "jose": "^5.9.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "redis": "^4.7.0",
    "remove-accents": "^0.5.0",
    "serve-favicon": "^2.5.0",
    "stripe": "^17.0.0",
    "swagger-ui-express": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "yamljs": "^0.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash": "^4.17.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/serve-favicon": "^2.5.7",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^6.0.0"
  }
}
