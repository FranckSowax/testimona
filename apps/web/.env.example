# Copier en .env.local et remplir. Ne jamais commiter de vraie valeur.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# --- Serveur uniquement ---
# Clé service-role : contourne la RLS. Réservée à src/server/privileged (voir ESLint).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PAYOUTS_INBOX_EMAIL=

# Génération vidéo IA (fal.ai). Higgsfield reste supporté en repli : HIGGSFIELD_API_ID / HIGGSFIELD_API_KEY.
FAL_KEY=

# Amélioration des annonces par l'IA (Claude Opus 5.5 via OpenRouter). Absente : le bouton « Améliorer avec l'IA » est masqué.
OPENROUTER_API_KEY=

# Sentry (build)
SENTRY_AUTH_TOKEN=

# Injecté par la CI / Railway
GIT_SHA=
