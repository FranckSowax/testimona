// Testimona — Prisma schema (Supabase Postgres).
// Apply with: `pnpm --filter @testimona/database prisma db push`
// RLS policies live in infra/supabase/rls/policies.sql and are applied separately.
//
// User auth is handled by Supabase auth.users — this schema only stores domain data.
// All `*Id` fields that reference users hold the auth.users.id uuid (no FK constraint
// at the Prisma level so RLS via auth.uid() remains the single source of truth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Memorial {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  ownerId           String        @db.Uuid
  firstname         String
  lastname          String
  nickname          String?
  birthDate         DateTime?     @db.Date
  deathDate         DateTime?     @db.Date
  language          String        @default("fr")
  isPublic          Boolean       @default(true)
  description       String?
  coverPhotoId      String?       @db.Uuid
  portraitUrl       String?
  coverUrl          String?
  birthCountry      String?
  birthCity         String?
  deathCountry      String?
  deathCity         String?
  relationship      String?
  donationGoalCents Int           @default(0)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  testimonials Testimonial[]
  photos       Photo[]
  biography    Biography?
  donations    Donation[]
  funeral      Funeral?
  favorites    MemorialFavorite[]

  @@index([ownerId])
  @@index([isPublic])
}

model Testimonial {
  id         String   @id @default(uuid()) @db.Uuid
  memorialId String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  /** Author's family relationship to the deceased (e.g. "Petite-fille"). */
  relationship String?
  message    String
  language   String   @default("fr")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial              @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  likes    TestimonialLike[]
  comments TestimonialComment[]
  reports  TestimonialReport[]

  @@index([memorialId])
}

model TestimonialLike {
  testimonialId String   @db.Uuid
  userId        String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@id([testimonialId, userId])
  @@index([testimonialId])
  @@index([userId])
}

model TestimonialComment {
  id            String   @id @default(uuid()) @db.Uuid
  testimonialId String   @db.Uuid
  authorId      String   @db.Uuid
  authorName    String
  message       String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([testimonialId])
}

model TestimonialReport {
  id            String   @id @default(uuid()) @db.Uuid
  testimonialId String   @db.Uuid
  reporterId    String   @db.Uuid
  reason        String
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([testimonialId])
  @@index([reporterId])
}

model Photo {
  id         String   @id @default(uuid()) @db.Uuid
  memorialId String   @db.Uuid
  url        String
  caption    String?
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId, position])
}

model Biography {
  id         String   @id @default(uuid()) @db.Uuid
  memorialId String   @unique @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial  @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  chapters Chapter[]
}

/// Per-account memorial favorites (heart) — see migration v21.
model MemorialFavorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  memorialId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@unique([userId, memorialId])
  @@index([userId, createdAt])
}

/// media: Json array of { url, type: 'image' | 'video' } — see migration v20.
model Chapter {
  id          String   @id @default(uuid()) @db.Uuid
  biographyId String   @db.Uuid
  title       String
  content     String
  position    Int      @default(0)
  media       Json     @default("[]")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  biography Biography @relation(fields: [biographyId], references: [id], onDelete: Cascade)

  @@index([biographyId, position])
}

model Donation {
  id              String   @id @default(uuid()) @db.Uuid
  memorialId      String   @db.Uuid
  donorId         String?  @db.Uuid
  amount          Int
  currency        String   @default("EUR")
  status          String   @default("Processing")
  stripeSessionId String?  @unique
  donorName       String?
  donorEmail      String?
  message         String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([donorId])
}

model Funeral {
  id         String   @id @default(uuid()) @db.Uuid
  memorialId String   @unique @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  memorial Memorial       @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  events   FuneralEvent[]
}

model FuneralEvent {
  id        String   @id @default(uuid()) @db.Uuid
  funeralId String   @db.Uuid
  title     String
  date      String?
  hour      String?
  url       String?
  note      String?
  location  String?
  address   String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  funeral Funeral @relation(fields: [funeralId], references: [id], onDelete: Cascade)

  @@index([funeralId, position])
}
